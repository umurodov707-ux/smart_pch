NODE_ENV=production
PORT=6878
ALLOWED_ORIGIN=https://test.smartpch.uz

# --- Xavfsizlik ---
# MUHIM: kamida 32 belgi. Productionda qisqa kalit bilan server ishga tushmaydi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super_maxfiy_uzun_kalit_uchun_32_belgi_va_undan_ortiq

# Google orqali kirish uchun MAJBURIY.
# Busiz /api/auth/google 503 qaytaradi (ilgari bu maydon tekshirilmagani uchun
# istalgan Google ilovasining tokeni bilan tizimga kirish mumkin edi).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# CSP qattiq rejimi. Eski public/ ilovasi inline onclick="..." ishlatgani uchun
# ODATIY HOLAT — mos (legacy) rejim. Buni yoqsangiz eski tugmalar ishlamay qoladi.
# Faqat public/ to'liq React'ga ko'chirilgandan keyin yoqing.
# STRICT_CSP=true

# --- So'rov hajmi chegaralari (ixtiyoriy) ---
# BODY_LIMIT=10mb
# LARGE_BODY_LIMIT=25mb

# --- Tashqi API kalitlari ---
WEATHER_API_KEY=openweathermap_api_kalitingiz_shu_yerda
GEMINI_API_KEY=gemini_api_kalitingiz_shu_yerda

DB_PATH=/var/www/smartpch/server/smart_pch.db

# --- Ma'lumotlar bazasi ---
# SQLite (default):
DB_TYPE=sqlite
# PostgreSQL (production tavsiya):
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_pch
